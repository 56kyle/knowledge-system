{
  "$defs": {
    "SourceLocator": {
      "additionalProperties": false,
      "description": "Exact source position or quote selector.",
      "properties": {
        "end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "exact_quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exact Quote"
        },
        "kind": {
          "enum": [
            "page",
            "heading",
            "timestamp",
            "quote",
            "line",
            "uri-fragment"
          ],
          "title": "Kind",
          "type": "string"
        },
        "prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prefix"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "suffix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suffix"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "source",
        "kind",
        "value"
      ],
      "title": "SourceLocator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable capture linked to an exact source version when applicable.",
  "properties": {
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "captured_by": {
      "title": "Captured By",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "locator": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceLocator"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Version"
    }
  },
  "required": [
    "id",
    "content_sha256",
    "captured_at",
    "captured_by"
  ],
  "title": "CaptureRecord",
  "type": "object"
}
