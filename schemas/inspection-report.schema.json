{
  "$defs": {
    "AgentPolicy": {
      "additionalProperties": false,
      "description": "Declared local mutation policy.",
      "properties": {
        "concurrency": {
          "const": "compare-and-swap",
          "default": "compare-and-swap",
          "title": "Concurrency",
          "type": "string"
        },
        "direct": {
          "default": [
            "register",
            "create",
            "set_field",
            "remove_field",
            "replace_subtree",
            "move",
            "reserve_collection",
            "retire_identity"
          ],
          "items": {
            "type": "string"
          },
          "title": "Direct",
          "type": "array"
        },
        "explicit_authorization": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Explicit Authorization",
          "type": "array"
        },
        "inbox_limits": {
          "$ref": "#/$defs/InboxLimits"
        },
        "review_required": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Review Required",
          "type": "array"
        }
      },
      "title": "AgentPolicy",
      "type": "object"
    },
    "CollectionIdentity": {
      "additionalProperties": false,
      "description": "Stable identity and trust placement of a collection.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "mode": {
          "default": "canonical",
          "enum": [
            "canonical",
            "inbox",
            "derived"
          ],
          "title": "Mode",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "trust_domain": {
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "title": "Trust Domain",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "trust_domain"
      ],
      "title": "CollectionIdentity",
      "type": "object"
    },
    "CollectionManifest": {
      "additionalProperties": false,
      "description": "Versioned collection contract loaded from collection.yaml.",
      "properties": {
        "agents": {
          "$ref": "#/$defs/AgentPolicy"
        },
        "collection": {
          "$ref": "#/$defs/CollectionIdentity"
        },
        "notes": {
          "$ref": "#/$defs/NoteDiscovery"
        },
        "profiles": {
          "$ref": "#/$defs/ProfileSelection"
        },
        "references": {
          "$ref": "#/$defs/OptionalReferences"
        },
        "relations": {
          "$ref": "#/$defs/RelationPolicy"
        },
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "collection"
      ],
      "title": "CollectionManifest",
      "type": "object"
    },
    "CollectionNote": {
      "additionalProperties": false,
      "description": "Parsed Markdown note and its collection-relative identity.",
      "properties": {
        "block_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Block Ids",
          "type": "array"
        },
        "body": {
          "title": "Body",
          "type": "string"
        },
        "content_sha256": {
          "title": "Content Sha256",
          "type": "string"
        },
        "envelope": {
          "anyOf": [
            {
              "$ref": "#/$defs/NoteEnvelope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "headings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Headings",
          "type": "array"
        },
        "links": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Links",
          "type": "array"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "properties": {
          "additionalProperties": true,
          "title": "Properties",
          "type": "object"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "path",
        "title",
        "body",
        "content_sha256"
      ],
      "title": "CollectionNote",
      "type": "object"
    },
    "EpistemicStatus": {
      "description": "Claim-level epistemic posture.",
      "enum": [
        "observation",
        "hypothesis",
        "supported",
        "contested",
        "refuted",
        "mixed"
      ],
      "title": "EpistemicStatus",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "One deterministic and machine-readable diagnostic.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "title": "Details",
          "type": "object"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "severity",
        "code",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "InboxLimits": {
      "additionalProperties": false,
      "description": "Bounds for agent-created inbox material.",
      "properties": {
        "bytes": {
          "default": 10000000,
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "files": {
          "default": 500,
          "minimum": 0,
          "title": "Files",
          "type": "integer"
        }
      },
      "title": "InboxLimits",
      "type": "object"
    },
    "LiteratureItem": {
      "additionalProperties": false,
      "description": "One Literature processing queue item.",
      "properties": {
        "checked": {
          "default": false,
          "title": "Checked",
          "type": "boolean"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "atomic",
                "project",
                "discarded",
                "duplicate",
                "deferred"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "review_due": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Due"
        },
        "review_event": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Event"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "LiteratureItem",
      "type": "object"
    },
    "NoteDiscovery": {
      "additionalProperties": false,
      "description": "Collection note discovery rules.",
      "properties": {
        "adapter": {
          "default": "portable",
          "enum": [
            "portable",
            "obsidian"
          ],
          "title": "Adapter",
          "type": "string"
        },
        "exclude": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Exclude",
          "type": "array"
        },
        "include": {
          "default": [
            "*.md",
            "**/*.md"
          ],
          "items": {
            "type": "string"
          },
          "title": "Include",
          "type": "array"
        },
        "roots": {
          "default": [
            "."
          ],
          "items": {
            "type": "string"
          },
          "title": "Roots",
          "type": "array"
        }
      },
      "title": "NoteDiscovery",
      "type": "object"
    },
    "NoteEnvelope": {
      "additionalProperties": false,
      "description": "Progressive metadata envelope for a registered Markdown note.",
      "properties": {
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "assets": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Assets",
          "type": "array"
        },
        "captures": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Captures",
          "type": "array"
        },
        "contributors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Contributors",
          "type": "array"
        },
        "created_by": {
          "title": "Created By",
          "type": "string"
        },
        "epistemic_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/EpistemicStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "flap_type": {
          "anyOf": [
            {
              "enum": [
                "fleeting",
                "literature",
                "atomic",
                "project"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flap Type"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "led_to": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Led To",
          "type": "array"
        },
        "literature_items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LiteratureItem"
          },
          "title": "Literature Items",
          "type": "array"
        },
        "origin": {
          "$ref": "#/$defs/Origin",
          "default": "human"
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "processing_state": {
          "anyOf": [
            {
              "enum": [
                "unfiled",
                "processed",
                "deferred"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Processing State"
        },
        "profiles": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Profiles",
          "type": "array"
        },
        "project_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project State"
        },
        "record_status": {
          "$ref": "#/$defs/RecordStatus",
          "default": "active"
        },
        "relations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Relation"
          },
          "title": "Relations",
          "type": "array"
        },
        "research_depth": {
          "anyOf": [
            {
              "enum": [
                "named",
                "scanned",
                "studied",
                "applied"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Research Depth"
        },
        "research_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Research Kind"
        },
        "research_role": {
          "anyOf": [
            {
              "enum": [
                "note",
                "map",
                "frontier"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Research Role"
        },
        "review": {
          "$ref": "#/$defs/ReviewAttestation"
        },
        "review_due": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Due"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        },
        "sources": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "tasks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProjectTask"
          },
          "title": "Tasks",
          "type": "array"
        },
        "up": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Up"
        }
      },
      "required": [
        "id",
        "created_by"
      ],
      "title": "NoteEnvelope",
      "type": "object"
    },
    "OptionalReferences": {
      "additionalProperties": false,
      "description": "References to owner-controlled policy and derived recipes.",
      "properties": {
        "asset_registry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Registry"
        },
        "capture_registry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capture Registry"
        },
        "catalog": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalog"
        },
        "projection_recipe": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Projection Recipe"
        },
        "source_registry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Registry"
        },
        "source_version_registry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version Registry"
        },
        "trust_policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trust Policy"
        },
        "trust_policy_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trust Policy Id"
        }
      },
      "title": "OptionalReferences",
      "type": "object"
    },
    "Origin": {
      "description": "How durable note material entered the collection.",
      "enum": [
        "human",
        "agent",
        "mixed",
        "imported"
      ],
      "title": "Origin",
      "type": "string"
    },
    "ProfileSelection": {
      "additionalProperties": false,
      "description": "Enabled profile versions and collection-specific settings.",
      "properties": {
        "enabled": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Enabled",
          "type": "object"
        },
        "settings": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Settings",
          "type": "object"
        }
      },
      "title": "ProfileSelection",
      "type": "object"
    },
    "ProjectTask": {
      "additionalProperties": false,
      "description": "One actionable Project task.",
      "properties": {
        "action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "checked": {
          "default": false,
          "title": "Checked",
          "type": "boolean"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "ProjectTask",
      "type": "object"
    },
    "RecordStatus": {
      "description": "Durable record lifecycle independent of FLAP.",
      "enum": [
        "active",
        "superseded",
        "retired"
      ],
      "title": "RecordStatus",
      "type": "string"
    },
    "Relation": {
      "additionalProperties": false,
      "description": "Typed edge retained in canonical Markdown.",
      "properties": {
        "confidence": {
          "$ref": "#/$defs/RelationConfidence",
          "default": "asserted"
        },
        "predicate": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Predicate",
          "type": "string"
        },
        "resolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelationResolution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "predicate",
        "target"
      ],
      "title": "Relation",
      "type": "object"
    },
    "RelationConfidence": {
      "description": "Whether an edge is authored or derived.",
      "enum": [
        "asserted",
        "inferred"
      ],
      "title": "RelationConfidence",
      "type": "string"
    },
    "RelationPolicy": {
      "additionalProperties": false,
      "description": "Relation vocabulary and default resolution behavior.",
      "properties": {
        "default_resolution": {
          "default": "required",
          "enum": [
            "required",
            "prospective"
          ],
          "title": "Default Resolution",
          "type": "string"
        },
        "prospective_predicates": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Prospective Predicates",
          "type": "array"
        },
        "vocabulary": {
          "default": "core@1",
          "title": "Vocabulary",
          "type": "string"
        }
      },
      "title": "RelationPolicy",
      "type": "object"
    },
    "RelationResolution": {
      "description": "Whether a relation target must already resolve.",
      "enum": [
        "required",
        "prospective"
      ],
      "title": "RelationResolution",
      "type": "string"
    },
    "ReviewAttestation": {
      "additionalProperties": false,
      "description": "Human review attestation for one content digest.",
      "properties": {
        "basis": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Basis"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "status": {
          "$ref": "#/$defs/ReviewStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "ReviewAttestation",
      "type": "object"
    },
    "ReviewStatus": {
      "description": "Trust status scoped to the current note revision.",
      "enum": [
        "unreviewed",
        "reviewed",
        "review_required"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "Severity": {
      "description": "Validation finding severity.",
      "enum": [
        "advisory",
        "warning",
        "error",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Read-only collection snapshot and diagnostics.",
  "properties": {
    "collection_root": {
      "title": "Collection Root",
      "type": "string"
    },
    "findings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "manifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/CollectionManifest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "notes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CollectionNote"
      },
      "title": "Notes",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "collection_root"
  ],
  "title": "InspectionReport",
  "type": "object"
}
