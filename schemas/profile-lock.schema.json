      },
      "title": "Profiles",
      "type": "array"
    },
    "relation_vocabularies": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProfileLock"
      },
      "title": "Relation Vocabularies",
      "type": "array"
    },
    "version": {
      "const": 1,
