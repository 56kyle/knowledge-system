{
  "$defs": {
    "RegistryEntry": {
      "additionalProperties": false,
      "description": "Verification state for one manifest-declared provenance record.",
      "properties": {
        "expected_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Sha256"
        },
        "observed_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Sha256"
        },
        "reference": {
          "title": "Reference",
          "type": "string"
        },
        "status": {
          "enum": [
            "verified",
            "unverifiable",
            "missing",
            "unavailable",
            "integrity_mismatch"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "status"
      ],
      "title": "RegistryEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Contained versioned registry of canonical provenance identities.",
  "properties": {
    "entries": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RegistryEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "title": "ProvenanceRegistry",
  "type": "object"
}
