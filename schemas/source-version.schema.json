{
  "additionalProperties": false,
  "description": "Immutable observed version of a source.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "locator": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Locator"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sha256"
    },
    "source": {
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "id",
    "source",
    "observed_at"
  ],
  "title": "SourceVersion",
  "type": "object"
}
