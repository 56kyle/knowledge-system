{
  "additionalProperties": false,
  "description": "One exact trust-domain set and its optional deployment handles.",
  "properties": {
    "credential_handle": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Credential Handle"
    },
    "domains": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Domains",
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "index_handle": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Index Handle"
    }
  },
  "required": [
    "id",
    "domains"
  ],
  "title": "TrustEnclaveDefinition",
  "type": "object"
}
